    <string name="err_transfer_cancelled">Transfer cancelled</string>
    <!-- The device folder already holds that name: the queue renamed it, so this
         only fires when the storage provider answers with an existing file. -->
    <string name="err_transfer_exists">A file named \"%1$s\" is already in the chosen folder</string>
    <string name="err_folder_not_writable">Could not write \"%1$s\" in the chosen folder — pick the folder again, or choose a folder that allows writing</string>
    <!-- The picker handed over a permission that only lives as long as the process:
         the copy starts normally and only breaks after a reboot, so the user has to
         be told NOW rather than find it out later. -->
    <string name="files_error_grant_not_persisted">The system would not keep the permission for what was picked: the copy works now but may fail after a restart</string>
    <!-- The server said "no" without saying why (full disk, quota, bad path): keep
         its own words as the detail instead of showing them bare. -->
    <string name="err_transfer_failed">The copy failed: %1$s</string>
    <!-- Opening a folder is not a copy, and it only READS: the same SFTP code has
         to be worded differently or the user goes off to fix permissions they never
         needed. -->
    <string name="err_browse_permission">No permission to open that folder — check its permissions on the server</string>
    <string name="err_browse_connection_lost">The connection dropped while opening the folder</string>
    <string name="err_browse_failed">The folder did not open: %1$s</string>

