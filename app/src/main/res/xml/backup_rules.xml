<?xml version="1.0" encoding="utf-8"?>
<!-- Same policy as data_extraction_rules.xml but for API 26-30 (fullBackupContent):
     no cloud backups or device transfers of any app data. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
